<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>  <?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<AnchorPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="fr.univ.calcudoku.controller.MenuController"
            style="-fx-background-color: white;">

    <StackPane AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0" 
               AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
        
        <VBox alignment="CENTER" spacing="20.0" maxWidth="600">
            
            <Label text="Calcudoku" style="-fx-font-size: 50px; -fx-font-weight: bold; -fx-text-fill: black;"/>
            
        <VBox minHeight="30" />

            <StackPane minHeight="67" maxHeight="67">
                
                <Button text="Jouer" onAction="#onJouerClick"
                        style="-fx-background-color: #81c784; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-min-width: 300px; -fx-min-height: 70px; -fx-cursor: hand;"/>

                <Pane maxWidth="0" maxHeight="0" StackPane.alignment="CENTER">
                    
                    <HBox fx:id="boxSousMenu" visible="false" alignment="CENTER_LEFT" spacing="0" 
                          translateX="160" translateY="-45">
                        
                        <Line endX="80.0" stroke="#333" strokeWidth="2" />
                        
                        <VBox spacing ="10.0">
                            <Button text="Jeu Libre" onAction="#onLibreClick" maxWidth="Infinity" style="-fx-background-color: #66bb6a; -fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-min-width: 100px; -fx-min-height: 50px;"/> 
                            <Button text="Aventure" onAction="#onAventureClick" maxWidth="Infinity" style="-fx-background-color: #66bb6a; -fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold; -fx-alignment: CENTER_LEFT; -fx-cursor: hand; -fx-min-width: 100px; -fx-min-height: 50px;"/>
                        </VBox>
                    </HBox>
                </Pane>
            </StackPane>

            <Button text="Tutoriel" 
                    style="-fx-background-color: #fdd835; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-min-width: 300px; -fx-min-height: 70px; -fx-cursor: hand;"/>

            <Button text="Option" 
                    style="-fx-background-color: #bdbdbd; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-min-width: 300px; -fx-min-height: 70px; -fx-cursor: hand;"/>

            <Button text="Quitter" onAction="#onQuitterClick"
                    style="-fx-background-color: #e57373; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold; -fx-min-width: 300px; -fx-min-height: 70px; -fx-cursor: hand;"/>

        </VBox>
    </StackPane>


    <VBox fx:id="boxProfil" alignment="CENTER" spacing="5" 
          AnchorPane.bottomAnchor="20.0" AnchorPane.rightAnchor="20.0"
          onMouseClicked="#onProfilClick"
          style="-fx-cursor: hand; -fx-padding: 10;">
          
        <ImageView fx:id="imgAvatar" fitWidth="80" fitHeight="80" preserveRatio="true"/>
        
        <Label fx:id="labelNomProfil" text="Nom" 
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: black;"/>
    </VBox>

</AnchorPane>