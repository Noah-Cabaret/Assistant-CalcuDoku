<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="fr.univ.calcudoku.controller.ProfilController"
      style="-fx-background-color: white; -fx-padding: 20;" spacing="20" alignment="TOP_CENTER">

    <BorderPane maxWidth="800">
        <left>
            <Button text="⬅" onAction="#onRetourClick"
                    style="-fx-background-color: transparent; -fx-font-size: 30px; -fx-cursor: hand; -fx-text-fill: black;"/>
        </left>
        
        <center>
            <VBox alignment="CENTER" spacing="5">
                <ImageView fx:id="imgAvatar" fitWidth="80" fitHeight="80" preserveRatio="true"/>
                <Label fx:id="lblNomProfil" text="Profil" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </VBox>
        </center>

        <right>
            <Button text="⎋" onAction="#onDeconnexionClick"
                    style="-fx-background-color: transparent; -fx-font-size: 30px; -fx-cursor: hand; -fx-text-fill: black; -fx-rotate: 90;"/> 
                    </right>
    </BorderPane>

    <HBox spacing="30" alignment="CENTER" maxWidth="800">
        
        <VBox HBox.hgrow="ALWAYS" alignment="TOP_CENTER" spacing="15" 
              style="-fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 20;">
            
            <Label text="Statistiques :" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            
            <VBox spacing="10" alignment="CENTER">
                <Label fx:id="lblTempsMoyen" text="Temps moyen : --:--" style="-fx-font-size: 14px;"/>
                <Label fx:id="lblTauxReussite" text="Taux de réussite : 0%" style="-fx-font-size: 14px;"/>
                <Label fx:id="lblNiveauAventure" text="Niveau mode aventure : 1" style="-fx-font-size: 14px;"/>
                <Label fx:id="lblDifficulteMax" text="Difficulté max : Facile" style="-fx-font-size: 14px;"/>
                <Label fx:id="lblMeilleurScore" text="Meilleur score : 0" style="-fx-font-size: 14px;"/>
            </VBox>
        </VBox>

        <VBox HBox.hgrow="ALWAYS" alignment="TOP_CENTER" spacing="15" 
              style="-fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 20;">
            
            <Label text="Paramètres :" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            
            <VBox spacing="10" alignment="CENTER">
                <CheckBox text="Mode sombre" style="-fx-font-size: 14px;"/>
                <CheckBox text="Mode claire" selected="true" style="-fx-font-size: 14px;"/>
                
                <Label text="Configuration bouton" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
                <Label text="d'aide au calcul" />
            </VBox>
        </VBox>
    </HBox>

    <VBox maxWidth="800" spacing="15" alignment="TOP_CENTER"
          style="-fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 20;">
        
        <Label text="Partie en cours" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <HBox spacing="40" alignment="CENTER">
            <VBox alignment="CENTER" spacing="5">
                <GridPane gridLinesVisible="true" style="-fx-border-color: black; -fx-padding: 2;">
                    <columnConstraints><ColumnConstraints minWidth="20"/><ColumnConstraints minWidth="20"/><ColumnConstraints minWidth="20"/><ColumnConstraints minWidth="20"/></columnConstraints>
                    <rowConstraints><RowConstraints minHeight="20"/><RowConstraints minHeight="20"/><RowConstraints minHeight="20"/><RowConstraints minHeight="20"/></rowConstraints>
                    <Label text="2+" style="-fx-font-size: 8;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                </GridPane>
                <Label text="Grille 5" style="-fx-font-weight: bold;"/>
                <Label text="Temps : 2:10"/>
            </VBox>

            <VBox alignment="CENTER" spacing="5">
                <GridPane gridLinesVisible="true" style="-fx-border-color: black; -fx-padding: 2;">
                    <columnConstraints><ColumnConstraints minWidth="20"/><ColumnConstraints minWidth="20"/><ColumnConstraints minWidth="20"/><ColumnConstraints minWidth="20"/></columnConstraints>
                    <rowConstraints><RowConstraints minHeight="20"/><RowConstraints minHeight="20"/><RowConstraints minHeight="20"/><RowConstraints minHeight="20"/></rowConstraints>
                    <Label text="8+" style="-fx-font-size: 8;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                </GridPane>
                <Label text="Grille 7" style="-fx-font-weight: bold;"/>
                <Label text="Temps : 0:50"/>
            </VBox>

            <VBox alignment="CENTER" spacing="5">
                <GridPane gridLinesVisible="true" style="-fx-border-color: black; -fx-padding: 2;">
                    <columnConstraints><ColumnConstraints minWidth="20"/><ColumnConstraints minWidth="20"/><ColumnConstraints minWidth="20"/><ColumnConstraints minWidth="20"/></columnConstraints>
                    <rowConstraints><RowConstraints minHeight="20"/><RowConstraints minHeight="20"/><RowConstraints minHeight="20"/><RowConstraints minHeight="20"/></rowConstraints>
                    <Label text="1-" style="-fx-font-size: 8;" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                </GridPane>
                <Label text="Grille 1" style="-fx-font-weight: bold;"/>
                <Label text="Temps : 3:50"/>
            </VBox>
        </HBox>
    </VBox>

</VBox>