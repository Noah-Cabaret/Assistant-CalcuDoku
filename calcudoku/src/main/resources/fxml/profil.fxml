<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="10.0" style="-fx-background-color: white; -fx-padding: 20;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.calcudoku.controller.ProfilController">

    <BorderPane maxWidth="800">
        <left>
            <Button onAction="#onRetourClick" style="-fx-background-color: transparent; -fx-font-size: 30px; -fx-cursor: hand; -fx-text-fill: black;" text="⬅" />
        </left>
        <center>
            <VBox alignment="CENTER" spacing="5">
                <ImageView fx:id="imgAvatar" fitHeight="50.0" fitWidth="50.0" preserveRatio="true" />
                <Label fx:id="lblNomProfil" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Profil">
               <font>
                  <Font size="8.0" />
               </font></Label>
            </VBox>
        </center>
        <right>
            <Button onAction="#onDeconnexionClick" style="-fx-background-color: transparent; -fx-font-size: 30px; -fx-cursor: hand; -fx-text-fill: black; -fx-rotate: 90;" text="⎋" /> 
        </right>
    </BorderPane>

    <HBox alignment="CENTER" maxWidth="800" spacing="20.0" VBox.vgrow="ALWAYS">
        
        <VBox alignment="TOP_CENTER" spacing="5.0" style="-fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 20;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Statistiques :" />
            <VBox alignment="CENTER" spacing="5.0">
                <Label fx:id="lblTempsMoyen" style="-fx-font-size: 14px;" text="Temps moyen : --:--" />
                <Label fx:id="lblTauxReussite" style="-fx-font-size: 14px;" text="Taux de réussite : 0%" />
                <Label fx:id="lblNiveauAventure" style="-fx-font-size: 14px;" text="Niveau mode aventure : 1" />
                <Label fx:id="lblDifficulteMax" style="-fx-font-size: 14px;" text="Difficulté max : Facile" />
                <Label fx:id="lblMeilleurScore" style="-fx-font-size: 14px;" text="Meilleur score : 0" />
            </VBox>
        </VBox>

        <VBox alignment="TOP_CENTER" style="-fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 20;" HBox.hgrow="ALWAYS">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Paramètres :" />
            
            <VBox alignment="CENTER" spacing="5.0">
                <CheckBox fx:id="checkSombre" style="-fx-font-size: 14px;" text="Mode sombre" />
                <CheckBox fx:id="checkClair" style="-fx-font-size: 14px;" text="Mode claire   " />
                
                <Label style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;" text="Configuration bouton" />
                <Label text="d'aide au calcul" />
            </VBox>
        </VBox>
    </HBox>

    <VBox alignment="TOP_CENTER" maxWidth="800" minHeight="280" style="-fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 20;">
        
        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Partie en cours" />

        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" pannable="true" style="-fx-background-color: transparent; -fx-background: white;" vbarPolicy="NEVER">
            
            <HBox fx:id="boxParties" alignment="CENTER_LEFT" spacing="30" style="-fx-background-color: white; -fx-padding: 10;">
            </HBox>
            
        </ScrollPane>
    </VBox>

</VBox>
