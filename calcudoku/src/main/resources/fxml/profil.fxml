<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: white; -fx-padding: 10;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.calcudoku.controller.ProfilController">

    <top>
        <BorderPane style="-fx-padding: 0 0 10 0;">
            <left>
                <Button onAction="#onRetourClick" style="-fx-background-color: transparent; -fx-font-size: 30px; -fx-cursor: hand; -fx-text-fill: black;" text="⬅" />
            </left>
            <center>
                <VBox alignment="CENTER" spacing="5">
                    <ImageView fx:id="imgAvatar" preserveRatio="true" />
                    <Label fx:id="lblNomProfil" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Profil" />
                </VBox>
            </center>
            <right>
                <Button onAction="#onDeconnexionClick" style="-fx-background-color: transparent; -fx-font-size: 30px; -fx-cursor: hand; -fx-text-fill: black; -fx-rotate: 90;" text="⎋" /> 
            </right>
        </BorderPane>
    </top>

    <center>
        <VBox fx:id="boxCentrale" alignment="TOP_CENTER" minWidth="0" spacing="10.0" style="-fx-padding: 5;" BorderPane.alignment="CENTER">
            
            <HBox alignment="CENTER" minWidth="0" spacing="10.0" VBox.vgrow="ALWAYS">
              
              <VBox alignment="TOP_CENTER" spacing="5.0" style="-fx-border-radius: 20; -fx-border-width: 1; -fx-border-color: black; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Touches" />
                    <RadioButton mnemonicParsing="false" text="Déplacement" />
                    <RadioButton mnemonicParsing="false" prefHeight="18.0" prefWidth="90.0" text="Placer chiffre" />
                    <RadioButton mnemonicParsing="false" prefHeight="18.0" prefWidth="91.0" text="Annotation" />
              </VBox>
                
                <VBox alignment="TOP_CENTER" spacing="5.0" style="-fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Statistiques :" />
                    <VBox alignment="CENTER" spacing="5.0">
                        <Label fx:id="lblTempsMoyen" style="-fx-font-size: 13px;" text="Temps moyen : --:--" />
                        <Label fx:id="lblTauxReussite" style="-fx-font-size: 13px;" text="Taux de réussite : 0%" />
                        <Label fx:id="lblNiveauAventure" style="-fx-font-size: 13px;" text="Niveau mode aventure : 1" />
                        <Label fx:id="lblDifficulteMax" style="-fx-font-size: 13px;" text="Difficulté max : Facile" />
                        <Label fx:id="lblMeilleurScore" style="-fx-font-size: 13px;" text="Meilleur score : 0" />
                    </VBox>
                </VBox>

                <VBox alignment="TOP_CENTER" spacing="5.0" style="-fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 10;" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Paramètres :" />
                    <VBox alignment="CENTER_LEFT" spacing="5.0" style="-fx-padding: 0 0 0 10;">
                        <RadioButton mnemonicParsing="false" text="Mode sombre" />
                        <RadioButton mnemonicParsing="false" text="Mode clair" />
                        <Label style="-fx-font-weight: bold; -fx-padding: 5 0 0 0;" text="Bouton d'aide au calcul" />
                        <RadioButton mnemonicParsing="false" text="Combinaisons" />
                        <RadioButton mnemonicParsing="false" text="Calculatrice" />
                    </VBox>
                </VBox>
            </HBox>

            <VBox alignment="TOP_CENTER" style="-fx-border-color: black; -fx-border-radius: 20; -fx-border-width: 1; -fx-padding: 10;" VBox.vgrow="ALWAYS">
                <Label style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-padding: 0 0 5 0;" text="Partie en cours" />
                
                <HBox fx:id="boxParties" alignment="CENTER_LEFT" minWidth="0" spacing="20" style="-fx-background-color: white; -fx-padding: 5;" VBox.vgrow="ALWAYS" />
            </VBox>

        </VBox>
    </center>
</BorderPane>
