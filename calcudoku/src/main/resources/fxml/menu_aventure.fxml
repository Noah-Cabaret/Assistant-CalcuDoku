<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.calcudoku.controller.MenuAventureController">
   <top>
      <BorderPane style="-fx-padding: 20;">
         <left>
            <Button mnemonicParsing="false" onAction="#onRetourClick" style="-fx-background-color: transparent; -fx-font-size: 30px; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅" />
         </left>
         <right>
            <Button mnemonicParsing="false" onAction="#onParametresClick" style="-fx-background-color: transparent; -fx-cursor: hand;">
               <graphic>
                  <ImageView fx:id="imgParametres" fitHeight="35.0" fitWidth="35.0" preserveRatio="true" />
               </graphic>
            </Button>
         </right>
      </BorderPane>
   </top>
   
   <center>
      <ScrollPane fitToWidth="true" fitToHeight="true" style="-fx-background-color: transparent; -fx-background: white;" vbarPolicy="AS_NEEDED" hbarPolicy="AS_NEEDED" BorderPane.alignment="CENTER">
         <content>
            <VBox alignment="CENTER" spacing="50.0" minWidth="0" minHeight="0" style="-fx-padding: 20;">
               <children>
                  <Label text="Mode Aventure">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>

                  <StackPane minWidth="0" minHeight="0" VBox.vgrow="ALWAYS">
                      <HBox fx:id="boxNiveaux" alignment="CENTER" spacing="0.0" minWidth="0" minHeight="0" />
                  </StackPane>
                  
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
   
   <bottom>
       <HBox alignment="BOTTOM_RIGHT" style="-fx-padding: 30;">
           <Button mnemonicParsing="false" onAction="#onResetClick" style="-fx-background-color: transparent; -fx-cursor: hand;">
               <graphic>
                  <ImageView fx:id="imgReset" fitHeight="40.0" fitWidth="40.0" preserveRatio="true" />
               </graphic>
           </Button>
       </HBox>
   </bottom>
</BorderPane>