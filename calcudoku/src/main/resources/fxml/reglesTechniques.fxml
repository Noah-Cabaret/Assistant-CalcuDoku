<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane style="-fx-padding: 15;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.calcudoku.controller.ReglesTechniquesController">

    <top>
        <BorderPane style="-fx-padding: 0 0 20 0;">
            <left>
                <Button fx:id="btnRetour" onAction="#onRetourClick" style="-fx-background-color: transparent; -fx-cursor: hand;">
                     <graphic><FontIcon iconLiteral="fas-arrow-left" iconSize="35" /></graphic>
                </Button>
            </left>
            <center>
                <Label fx:id="lblTitreHaut" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-padding: 10 30 10 30;" text="Règles du Calcudoku" BorderPane.alignment="CENTER" />
            </center>
            <right>
                <Label minWidth="60" /> 
            </right>
        </BorderPane>
    </top>

    <left>
        <VBox spacing="10" style="-fx-padding: 0 20 0 0;" BorderPane.alignment="TOP_LEFT">
            <fx:define>
                <ToggleGroup fx:id="groupeOnglets" />
            </fx:define>
            
            <ToggleButton fx:id="btnRegles" text="Règles" toggleGroup="$groupeOnglets" selected="true" onAction="#afficherRegles" prefWidth="150" prefHeight="50" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 10; -fx-border-color: #999999; -fx-border-radius: 10;" />
            <ToggleButton text="Fonctionnalités" toggleGroup="$groupeOnglets" onAction="#afficherFonctionnalites" prefWidth="150" prefHeight="50" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 10; -fx-border-color: #999999; -fx-border-radius: 10;" />
            <ToggleButton text="Techniques 1 (Bloc unique)" toggleGroup="$groupeOnglets" onAction="#afficherBlocsUniques" prefWidth="150" prefHeight="50" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 10; -fx-border-color: #999999; -fx-border-radius: 10;" />
            <ToggleButton text="Techniques 2 (Candidat unique)" toggleGroup="$groupeOnglets" onAction="#afficherCandidatUnique" prefWidth="150" prefHeight="50" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 10; -fx-border-color: #999999; -fx-border-radius: 10;" />
            <ToggleButton text="Techniques 3 (Rest de grille)" toggleGroup="$groupeOnglets" onAction="#afficherResteGrille" prefWidth="150" prefHeight="50" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 10; -fx-border-color: #999999; -fx-border-radius: 10;" />
            <ToggleButton text="Techniques 4 (Intra bloc)" toggleGroup="$groupeOnglets" onAction="#afficherIntraBloc" prefWidth="150" prefHeight="50" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 10; -fx-border-color: #999999; -fx-border-radius: 10;" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <VBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 10 40 10 40;">
                
                <Label fx:id="lblTexte" wrapText="true" style="-fx-font-size: 16px; -fx-line-spacing: 5px;" 
                       text="Lorem ipsum dolor sit amet, consectetur adipiscing elit..." />
                
                <ImageView fx:id="imgExemple" fitWidth="300" preserveRatio="true" />

                <HBox alignment="CENTER" spacing="100">
                    <Button fx:id="btnPrecedent" onAction="#onPagePrecedente" style="-fx-background-color: transparent; -fx-cursor: hand;">
                        <graphic><FontIcon fx:id="iconPrecedent" iconLiteral="fas-chevron-left" iconSize="40"/></graphic>
                    </Button>
                    <Label fx:id="lblLegendeImage" text="Grille si besoin de montrer" style="-fx-font-size: 12px; -fx-text-fill: gray;" />
                    <Button fx:id="btnSuivant" onAction="#onPageSuivante" style="-fx-background-color: transparent; -fx-cursor: hand;">
                        <graphic><FontIcon fx:id="iconSuivant" iconLiteral="fas-chevron-right" iconSize="40"/></graphic>
                    </Button>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

</BorderPane>