<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.calcudoku.controller.JeuController">
   <center>
      <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets top="20.0" bottom="20.0" />
         </padding>
         <children>
            <Label text="2:30">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>

            <StackPane fx:id="conteneurGrille" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets top="10.0" right="20.0" bottom="10.0" left="20.0" />
               </padding>
            </StackPane>

            <VBox alignment="CENTER" spacing="10.0">
               <children>
                  <HBox fx:id="conteneurBoutonsNombres" alignment="CENTER" spacing="8.0" />

                  <HBox alignment="CENTER" spacing="8.0">
                     <children>
                        <Button fx:id="btnUndo" mnemonicParsing="false" onAction="#actionUndo" text="⬅" style="-fx-font-size: 16px;"/>
                        <Button fx:id="btnRedo" mnemonicParsing="false" onAction="#actionRedo" text="➡" style="-fx-font-size: 16px;"/>
                        <Button fx:id="btnAnnoter" mnemonicParsing="false" onAction="#actionBasculeAnnotation" text="🖊" style="-fx-font-size: 16px;"/>
                        <Button fx:id="btnEffacer" mnemonicParsing="false" onAction="#actionEffacer" text="❌" style="-fx-font-size: 16px;"/>
                        <Button fx:id="btnCalculatrice" mnemonicParsing="false" onAction="#actionCalculatrice" text="🖩" style="-fx-font-size: 16px;"/>
                     </children>
                  </HBox>
               </children>
               <VBox.margin>
                  <Insets top="15.0" />
               </VBox.margin>
            </VBox>
         </children>
      </VBox>
   </center>
</BorderPane>