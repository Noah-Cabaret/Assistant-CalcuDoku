<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="800.0" prefWidth="1000.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="fr.univ.calcudoku.controller.MenuAventureController">
   <top>
      <BorderPane style="-fx-padding: 20;">
         <left>
            <Button mnemonicParsing="false" onAction="#onRetourClick" style="-fx-background-color: transparent; -fx-font-size: 30px; -fx-font-weight: bold; -fx-cursor: hand;" text="⬅" />
         </left>
         <right>
            <Button mnemonicParsing="false" onAction="#onParametresClick" style="-fx-background-color: transparent; -fx-cursor: hand;">
               <graphic>
                  <ImageView fx:id="imgParametres" fitHeight="35.0" fitWidth="35.0" preserveRatio="true" />
               </graphic>
            </Button>
         </right>
      </BorderPane>
   </top>
   
   <center>
      <VBox alignment="CENTER" spacing="80.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="Mode Aventure">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>

            <StackPane>
                <HBox alignment="CENTER" style="-fx-padding: 30px 0;">
                    <StackPane fx:id="ligneFond" style="-fx-background-color: black; -fx-pref-height: 6px; -fx-max-height: 6px;" />
                </HBox>
                
                <HBox fx:id="boxNiveaux" alignment="CENTER" spacing="60.0" />
            </StackPane>
            
         </children>
      </VBox>
   </center>
   
   <bottom>
       <HBox alignment="BOTTOM_RIGHT" style="-fx-padding: 30;">
           <Button mnemonicParsing="false" onAction="#onResetClick" style="-fx-background-color: transparent; -fx-cursor: hand;">
               <graphic>
                  <ImageView fx:id="imgReset" fitHeight="40.0" fitWidth="40.0" preserveRatio="true" />
               </graphic>
           </Button>
       </HBox>
   </bottom>
</BorderPane>
